# Normalize line endings across platforms.
* text=auto

# Maven wrapper scripts
mvnw text eol=lf
mvnw.cmd text eol=crlf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.cmd text eol=crlf
*.bat text eol=crlf

# Source and configuration files
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
